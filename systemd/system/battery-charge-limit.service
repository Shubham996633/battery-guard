[Unit]
Description=Apply battery charge limit to the embedded controller
After=multi-user.target
ConditionPathExistsGlob=/sys/class/power_supply/BAT*/charge_control_end_threshold

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/battery-charge-limit --apply

[Install]
WantedBy=multi-user.target
