#!/usr/bin/env python3
"""battery-tray - status-bar/tray indicator with remaining time and cap control.

Uses the AppIndicator (StatusNotifierItem) protocol, which Zorin's
zorin-appindicator extension already renders, so it appears in the panel
tray immediately - no shell restart, no logout.
"""

import os
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("AyatanaAppIndicator3", "0.1")
from gi.repository import AyatanaAppIndicator3 as AppIndicator  # noqa: E402
from gi.repository import GLib, Gtk  # noqa: E402

sys.path.insert(0, os.path.expanduser("~/.local/lib/battery-guard"))
import battlib  # noqa: E402

REFRESH_SECONDS = 10
LIMIT_TOOL = "/usr/local/sbin/battery-charge-limit"
HUD = os.path.expanduser("~/.local/bin/battery-hud")


def icon_for(snap):
    """Nearest Adwaita battery-level icon, falling back if the theme lacks it."""
    percent = snap.get("percent") or 0
    level = max(0, min(100, int(round(percent / 10.0) * 10)))
    theme = Gtk.IconTheme.get_default()
    names = []
    if snap.get("charging"):
        names.append(f"battery-level-{level}-charging-symbolic")
    elif snap.get("holding") and snap.get("ac_online"):
        names.append(f"battery-level-{level}-charged-symbolic")
    names += [
        f"battery-level-{level}-symbolic",
        "battery-good-symbolic",
        "battery-symbolic",
    ]
    for name in names:
        if theme.has_icon(name):
            return name
    return "battery-symbolic"


class Tray:
    def __init__(self):
        self.indicator = AppIndicator.Indicator.new(
            "battery-guard", "battery-good-symbolic",
            AppIndicator.IndicatorCategory.HARDWARE)
        self.indicator.set_status(AppIndicator.IndicatorStatus.ACTIVE)
        self.indicator.set_title("Battery")

        self.menu = Gtk.Menu()
        self.m_headline = self._info_item()
        self.m_detail = self._info_item()
        self.m_health = self._info_item()
        self.menu.append(Gtk.SeparatorMenuItem())
        self.m_cap = self._info_item()

        cfg = battlib.load_config()
        target = int(cfg["target_max"])
        self._action(f"Limit charging to {target}%", lambda *_: self._set_limit(target))
        self._action("Allow full charge (travel)", lambda *_: self._set_limit(100))
        self.menu.append(Gtk.SeparatorMenuItem())
        self._action("Open Battery app", lambda *_: self._spawn([HUD]))
        self._action("Refresh now", lambda *_: self.refresh())
        self._action("Quit tray", lambda *_: Gtk.main_quit())

        self.menu.show_all()
        self.indicator.set_menu(self.menu)

        self.refresh()
        GLib.timeout_add_seconds(REFRESH_SECONDS, self.refresh)

    def _info_item(self):
        item = Gtk.MenuItem(label="...")
        item.set_sensitive(False)
        self.menu.append(item)
        return item

    def _action(self, label, cb):
        item = Gtk.MenuItem(label=label)
        item.connect("activate", cb)
        self.menu.append(item)
        return item

    def _spawn(self, argv):
        try:
            subprocess.Popen(argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass

    def _set_limit(self, value):
        # pkexec raises the normal GNOME password dialog.
        self._spawn(["pkexec", LIMIT_TOOL, str(value)])
        GLib.timeout_add_seconds(4, self.refresh)

    def refresh(self):
        snap = battlib.snapshot()
        if not snap.get("present"):
            self.indicator.set_label("no battery", "no battery")
            return True

        fd, fc = battlib.fmt_duration, battlib.fmt_clock
        p = snap["percent"]
        tmax, tmin = snap["target_max"], snap["target_min"]

        if snap["charging"]:
            self.indicator.set_label(f"{p}% ↑ {fc(snap['seconds_to_target'])}", "100% ↑ 0:00")
            self.m_headline.set_label(f"Charging — {fd(snap['seconds_to_target'])} to the {tmax}% cap")
        elif snap["discharging"]:
            self.indicator.set_label(f"{p}% ↓ {fc(snap['seconds_to_empty'])}", "100% ↓ 0:00")
            self.m_headline.set_label(f"On battery — {fd(snap['seconds_to_empty'])} to empty")
        else:
            self.indicator.set_label(f"{p}% · cap", "100% · cap")
            self.m_headline.set_label(f"Holding at {p}% — charging stopped by the cap")

        watts = f"{snap['power_w']:.1f} W" if snap["power_w"] else "idle"
        if snap["discharging"]:
            self.m_detail.set_label(f"{watts} · {fd(snap['seconds_to_floor'])} to the {tmin}% floor")
        else:
            self.m_detail.set_label(f"{watts} · {snap['status']}")

        health = f"{snap['health_pct']:.1f}%" if snap["health_pct"] is not None else "--"
        wh = ""
        if snap["energy_full_wh"] and snap["energy_design_wh"]:
            wh = f" ({snap['energy_full_wh']:.2f} / {snap['energy_design_wh']:.2f} Wh)"
        self.m_health.set_label(f"Health {health}{wh}")

        self.m_cap.set_label(
            f"Charge limit {snap['cap_limit']}% (firmware enforced)" if snap["cap_applied"]
            else f"Charge limit {snap['cap_limit']}% — target is {tmax}%")

        self.indicator.set_icon_full(icon_for(snap), f"Battery {p}%")
        return True


if __name__ == "__main__":
    Tray()
    Gtk.main()
