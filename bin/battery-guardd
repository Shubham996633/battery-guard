#!/usr/bin/env python3
"""battery-guardd - desktop notifications for battery limits.

Runs as a user systemd service. Notifies on the way down (configurable
steps, default 20/15/10/5) and when charging reaches the cap.
Each channel reuses one notification id so nothing stacks up, and every
alert has hysteresis so it cannot re-fire while hovering on a boundary.

Two situations repeat every reminder_minutes until they are dealt with:
charging past the target with no firmware limit to stop it, and a critically
low battery. `battery-guardd --test` sends a sample alert and sound.
Also adds one line a day to the battery health history.
"""

import datetime
import os
import shutil
import subprocess
import sys
import time

sys.path.insert(0, os.path.expanduser("~/.local/lib/battery-guard"))
import battlib  # noqa: E402

APP = "Battery Guard"
HYSTERESIS = 3  # percent you must climb back above before a step re-arms
CRITICAL_PERCENT = 10  # at or below this, low-battery alerts keep repeating

SOUND_FILES = {
    "warning": "/usr/share/sounds/freedesktop/stereo/dialog-warning.oga",
    "done": "/usr/share/sounds/freedesktop/stereo/complete.oga",
    "plug": "/usr/share/sounds/freedesktop/stereo/power-plug.oga",
    "unplug": "/usr/share/sounds/freedesktop/stereo/power-unplug.oga",
}

_notify_ids = {}
_player = None
_sound_on = True


def log(message):
    """Goes to the journal: journalctl --user -u battery-guard -f"""
    print(message, flush=True)


def find_player():
    """Pick whatever audio CLI this box actually has; None is fine."""
    for cmd, build in (
        ("canberra-gtk-play", lambda f: ["canberra-gtk-play", "-f", f]),
        ("pw-play", lambda f: ["pw-play", f]),
        ("paplay", lambda f: ["paplay", f]),
        ("gst-play-1.0", lambda f: ["gst-play-1.0", "--no-interactive", f]),
        ("ffplay", lambda f: ["ffplay", "-nodisp", "-autoexit", "-loglevel", "quiet", f]),
    ):
        if shutil.which(cmd):
            return build
    return None


def play(kind):
    path = SOUND_FILES.get(kind)
    if not _sound_on or not _player or not path or not os.path.exists(path):
        return
    try:
        subprocess.Popen(_player(path), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def notify(channel, title, body, icon, urgency="normal", sound=None):
    cmd = ["notify-send", "-a", APP, "-i", icon, "-u", urgency, "-p",
           "-h", "string:desktop-entry:battery-hud"]
    if channel in _notify_ids:
        cmd += ["-r", str(_notify_ids[channel])]
    cmd += [title, body]
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
        nid = out.stdout.strip()
        if nid.isdigit():
            _notify_ids[channel] = int(nid)
    except (OSError, subprocess.SubprocessError) as exc:
        log(f"notify[{channel}] FAILED: {exc}")
        return
    log(f"notify[{channel}] {urgency}: {title} | {body}")
    if sound:
        play(sound)


def low_urgency(step, floor):
    return "critical" if step <= max(10, floor // 2) else "normal"


def low_message(level, percent, eta):
    if level <= 5:
        return f"Battery critical - {percent}%", f"About {eta} left. Plug in now."
    return (f"Battery low - {percent}%",
            f"About {eta} left before empty. Charge to protect the cells.")


def send_test_alert():
    notify("test", "Battery Guard test", "Alerts and sound are working.",
           "battery-caution-symbolic", sound="warning")


def main():
    global _player, _sound_on
    _player = find_player()

    if "--test" in sys.argv[1:]:
        send_test_alert()
        return

    fired_low = set()
    fired_full = False
    fired_drift = False
    last_status = None
    last_ac = None
    last_low_alert = None
    last_full_alert = None

    while True:
        cfg = battlib.load_config()
        _sound_on = bool(cfg["sound"])
        snap = battlib.snapshot(cfg)
        if not snap.get("present"):
            time.sleep(60)
            continue

        battlib.record_health(snap, datetime.date.today().isoformat())

        p = snap["percent"] or 0
        tmax = snap["target_max"]
        fd = battlib.fmt_duration
        now = time.monotonic()
        reminder_minutes = cfg["reminder_minutes"]

        # --- charger plugged in or pulled out ----------------------------
        ac = snap["ac_online"]
        if cfg["plug_sounds"] and last_ac is not None and ac != last_ac:
            play("plug" if ac else "unplug")
        last_ac = ac

        # --- the way down -------------------------------------------------
        if snap["discharging"]:
            fired_full = False
            last_full_alert = None
            for step in cfg["low_steps"]:
                if p <= step and step not in fired_low:
                    title, body = low_message(step, p, fd(snap["seconds_to_empty"]))
                    notify("low", title, body, "battery-caution-symbolic",
                           low_urgency(step, snap["target_min"]), sound="warning")
                    fired_low.add(step)
                    last_low_alert = now
            # Re-arm a step only once we are comfortably back above it.
            fired_low = {s for s in fired_low if p <= s + HYSTERESIS}
            if p <= CRITICAL_PERCENT and battlib.reminder_due(last_low_alert, now, reminder_minutes):
                title, body = low_message(p, p, fd(snap["seconds_to_empty"]))
                notify("low", title, body, "battery-caution-symbolic", "critical", sound="warning")
                last_low_alert = now

        # --- the way up ---------------------------------------------------
        elif snap["charging"] or snap["holding"]:
            fired_low.clear()
            last_low_alert = None
            if cfg["notify_full"] and battlib.cap_reached(snap):
                holding_at_cap = snap["cap_applied"]
                keep_reminding = (not holding_at_cap
                                  and battlib.reminder_due(last_full_alert, now, reminder_minutes))
                if not fired_full or keep_reminding:
                    if holding_at_cap:
                        title = f"Battery at {p}% - charging stopped"
                        near = "" if p >= tmax else " Firmware terminates a little under the setpoint."
                        body = f"The {tmax}% limit is holding.{near} Safe to leave plugged in."
                    elif snap["cap_limit"] is None:
                        title = f"Battery at {p}% - unplug"
                        body = f"Past your {tmax}% target. This laptop can't stop charging by itself."
                    else:
                        title = f"Battery at {p}% - unplug"
                        body = f"At or above your {tmax}% target and the firmware limit is not enforcing it."
                    notify("full", title, body, "battery-full-charged-symbolic",
                           "normal" if holding_at_cap else "critical",
                           sound="done" if holding_at_cap else "warning")
                    fired_full = True
                    last_full_alert = now
            if p < tmax - HYSTERESIS:
                fired_full = False
                last_full_alert = None

        # --- the cap itself slipped --------------------------------------
        drift = cfg["notify_cap_drift"] and snap["cap_limit"] is not None and not snap["cap_applied"]
        if drift and not fired_drift:
            notify("drift", "Charge limit not applied",
                   f"EC limit is {snap['cap_limit']}%, your target is {tmax}%. "
                   f"Run: sudo battery-charge-limit {tmax}",
                   "dialog-warning-symbolic", "critical", sound="warning")
            fired_drift = True
        elif not drift:
            fired_drift = False

        if snap["status"] != last_status:
            log(f"state: {snap['status']} at {p}% "
                f"(ac={snap['ac_online']}, cap={snap['cap_limit']}%, "
                f"cap_reached={battlib.cap_reached(snap)})")
            last_status = snap["status"]

        time.sleep(max(5, int(cfg["poll_seconds"])))


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
